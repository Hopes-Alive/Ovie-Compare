# Backend + workers only — never commit .env or use in frontend

SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → secret key (service_role)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Dashboard → Settings → Database → Connection string → password
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Azure OpenAI — used for text embeddings (text-embedding-3-small, 1536 dims)
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
# Deployment name in Azure AI Foundry
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# API version that supports text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# LlamaIndex Cloud — used for document parsing
LLAMA_INDEX_API_KEY=your-llama-index-key

# Brain LLM — Azure AI Foundry (gpt-5.4-mini)
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/api/projects/proj-default/openai/v1
AZURE_FOUNDRY_API_KEY=your-azure-foundry-key
AZURE_FOUNDRY_DEPLOYMENT=gpt-5.4-mini

# Backend API server port
PORT=4000

# Scheduler tick interval (seconds, default 60)
REFRESH_SCHEDULER_TICK_SECONDS=60
